{
  "manifest_version": 3,
  "name": "The Social Sofa",
  "version": "1.0.0",
  "description": "Start Social Sofa watch parties from YouTube or invite links. Watch together in sync.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "The Social Sofa",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage", "tabs", "clipboardWrite"],
  "host_permissions": [
    "https://netflixclone-pearl-eight.vercel.app/*",
    "http://localhost:3000/*"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "social-sofa@thesocialsofa.app",
      "strict_min_version": "109.0"
    }
  }
}
